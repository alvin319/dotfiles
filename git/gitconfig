[core]
	pager = less -R --mouse
[init]
	defaultBranch = main
[pull]
	rebase = false
[credential]
	helper = cache --timeout=86400
[credential "https://github.com"]
	helper = !gh auth git-credential
# Machine-local overrides (work email, signing keys, ...). Not tracked. Must stay last so it wins.
[include]
	path = ~/.gitconfig.local
