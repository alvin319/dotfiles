# ~/.zshrc — shared across macOS and Linux (symlinked from ~/dotfiles/zsh/zshrc).
# Machine-specific or work-specific settings go in ~/.zshrc.local (untracked).

# ---- Powerlevel10k instant prompt (must stay near the top) -------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# ---- Oh My Zsh ---------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
# fzf-tab is a custom plugin: $ZSH/custom/plugins/fzf-tab (cloned by install.sh).
plugins=(git tmux fzf-tab)
source $ZSH/oh-my-zsh.sh

# fzf-tab: fuzzy tab completion
zstyle ':completion:*:git-checkout:*' sort false           # keep git's own branch ordering
zstyle ':completion:*:descriptions' format '[%d]'          # group headers fzf-tab can switch between
zstyle ':completion:*' menu no                             # let fzf-tab own the menu
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'tree -C $realpath 2>/dev/null | head -100'
zstyle ':fzf-tab:complete:(-command-|-parameter-|-brace-parameter-|export|unset|expand):*' fzf-preview 'echo ${(P)word}'
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup             # popup inside tmux, plain fzf outside
zstyle ':fzf-tab:*' popup-min-size 80 15
zstyle ':fzf-tab:*' switch-group '<' '>'                   # cycle completion groups

# ---- Aliases -----------------------------------------------------------------
if [[ $OSTYPE == darwin* ]]; then
  alias ls='ls -G'
  alias lsd='ls -G -lF | grep "^d"'                 # only directories
else
  alias ls='ls --color=auto'
  alias lsd='ls --color=always -lF | grep "^d"'     # only directories
fi
alias l='ls -lF'      # long format
alias la='ls -laF'    # long format, incl. dotfiles
alias ll='ls -l'
alias sudo='sudo '    # let aliases work under sudo

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'
alias grm='git rm $(git ls-files --deleted)'

export COLORTERM="truecolor"
export EDITOR=vim

# ---- fzf ---------------------------------------------------------------------
# fd-backed search (respects .gitignore, skips .git), previews, tmux popup when inside tmux
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always --line-range :300 {}'"
export FZF_ALT_C_OPTS="--preview 'tree -C {} | head -200'"
export FZF_TMUX_OPTS="-p 80%,60%"
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh                     # generated by ~/.fzf/install
# fzf-git: ctrl-g then ctrl-{b,f,t,r,h,l,w,e,s} = branches, files, tags, remotes, hashes, reflog, worktrees, each-ref, stashes
[ -f ~/.fzf-git.sh/fzf-git.sh ] && source ~/.fzf-git.sh/fzf-git.sh

# ---- Terminal integrations ---------------------------------------------------
test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh"

# Terminal-mode cleanup after ssh/coder sessions. Remote apps (Claude Code in
# tmux) turn on mouse/focus reporting and bracketed paste; if the connection
# dies they never turn them off and the local shell sees wheel events as text
# like "64;145;21M". Reset those modes whenever ssh/coder returns.
_term_modes_reset() {
  [[ -t 1 ]] || return 0
  { printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1004l\e[?2004l' > /dev/tty; } 2>/dev/null
  return 0
}
alias fixterm='_term_modes_reset'
ssh()   { command ssh   "$@"; local rc=$?; _term_modes_reset; return $rc }
coder() { command coder "$@"; local rc=$?; _term_modes_reset; return $rc }

# ---- Prompt ------------------------------------------------------------------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ---- Machine-local / work settings (not in the repo) --------------------------
# Private indexes, ssh aliases, tokens: see zsh/zshrc.local.example
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# ---- Autosuggestions + syntax highlighting (must be last) --------------------
# apt: zsh-autosuggestions zsh-syntax-highlighting   brew: same names
for _d in /usr/share /opt/homebrew/share /usr/local/share; do
  [ -f $_d/zsh-autosuggestions/zsh-autosuggestions.zsh ] && source $_d/zsh-autosuggestions/zsh-autosuggestions.zsh && break
done
for _d in /usr/share /opt/homebrew/share /usr/local/share; do
  [ -f $_d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && source $_d/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh && break
done
unset _d
