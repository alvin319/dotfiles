# ~/.zshrc.local — machine-specific and work-specific settings.
# Sourced by ~/.zshrc if present. NOT tracked in the dotfiles repo.
# Copy this file to ~/.zshrc.local and fill in what applies to this machine.

# Private package index (uv)
# export UV_INDEX="name=https://oauth2accesstoken@REGION-python.pkg.dev/PROJECT/REPO/simple/"

# ssh shortcuts to remote boxes
# alias remotecoder="ssh coder.my-box"

# Anything else that should not be public: tokens, internal hostnames, etc.
